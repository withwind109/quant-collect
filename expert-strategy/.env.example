# =============================================================================
# expert-platform 环境变量样例 —— 复制为 .env 后填入真实值（.env 已在 .gitignore）
# =============================================================================

# ── 东方财富（社区高手主数据源）─────────────────────────────────────────────
# 浏览器登录东方财富官网后复制的完整 Cookie（不再使用扫码登录）。
# 失效表现: 榜单/接口返回空或被 WAF 拦截，重新复制一份即可。
EASTMONEY_COOKIE=

# ── 雪球（可选: 热门组合调仓明细需要登录态）──────────────────────────────────
XUEQIU_COOKIE=

# ── 同花顺（可选: 模拟炒股榜单匿名可看, 逐笔明细需登录 + hexin-v 令牌）─────
THS_COOKIE=
THS_HEXIN_V=

# ── 支付宝/蚂蚁财富（可选: 需自行抓包提供端点, 见 config.yaml alipay 段）───
ALIPAY_RANK_URL=
ALIPAY_TRADE_URL=
ALIPAY_COOKIE=

# ── HTTP 代理（可选）────────────────────────────────────────────────────────
HTTP_PROXY=

# ── SQLite 主库路径（可选, 默认 data/experts.db）───────────────────────────
EXPERTS_DB=

# ── 回测执行口径（可选: v1=旧口径, 默认 v2 统一口径）────────────────────────
# XCQ_EXIT_SEMANTICS=v2
